NODE_ENV=development
PORT=4000

DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/jobwork_local"

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5175

UPLOAD_DIR=uploads

# LLM provider: "stub" | "openai" | "claude"
LLM_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
